COMPOSE_PROJECT_NAME=wordpress
DOCKER_PLATFORM=linux/amd64

# Public endpoint. SITE_HOST is only the host; WORDPRESS_URL is the full URL.
SITE_HOST=localhost
HTTP_PORT=8080
WORDPRESS_URL=http://localhost:8080

# Replace both passwords before starting the stack.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
WORDPRESS_TABLE_PREFIX=wp_

# Runtime sizing defaults.
VARNISH_SIZE=256M
MEMCACHED_MEMORY_MB=128
MEMCACHED_MAX_CONNECTIONS=1024
MEMCACHED_THREADS=4
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
WORDPRESS_DEBUG=false

# Public Docker Hub image tags.
WORDPRESS_IMAGE=wordpress:7.0.2-php8.3-fpm
WORDPRESS_LOCAL_IMAGE=portable-wordpress:7.0.2-php8.3-fpm-nginx
MYSQL_IMAGE=mysql:8.4.10
VARNISH_IMAGE=varnish:6.0.18
MEMCACHED_IMAGE=memcached:1.6.45-alpine
TRAEFIK_IMAGE=traefik:v3.7.5
MEMCACHED_PHP_VERSION=3.3.0
